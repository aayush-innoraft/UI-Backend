<?php

use Drupal\node\Entity\Node;
use Drupal\node\Entity\NodeType;

/**
 * Implements hook_cron().
 */

function trying_cron_cron() {
  // Log the time when cron runs.
  \Drupal::logger('trying_cron')->notice('Running cron at @time', [
    '@time' => date('H:i:s'),
  ]);

  // Create the content type if it doesn't exist.
  if (!NodeType::load('tryCron')) {
    $type = NodeType::create([
      'type' => 'tryCron',
      'name' => 'Trying Cron',
    ]);
    $type->save();
    \Drupal::logger('trying_cron')->notice('Content type "tryCron" created.');
  }
  
  // Create a node of type 'tryCron'.
  $node = Node::create([
    'type' => 'tryCron',
    'title' => 'tryCron ' . date('Y-m-d H:i:s'),
  ]);
  $node->save();
  \Drupal::logger('trying_cron')->notice('Node created with title: @title', [
    '@title' => $node->label(),
  ]);
}
